FROM node:24-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash ca-certificates curl findutils git jq less procps ripgrep fd-find \
  && rm -rf /var/lib/apt/lists/*
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
RUN curl -1sLf https://dl.cloudsmith.io/public/task/task/setup.deb.sh -o /tmp/task-setup.sh \
  && bash /tmp/task-setup.sh \
  && apt-get update \
  && apt-get install -y --no-install-recommends task \
  && rm -f /tmp/task-setup.sh \
  && rm -rf /var/lib/apt/lists/*

ENV UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_LINK_MODE=copy \
    PATH="/workspace/.venv/bin:$PATH"
RUN uv python install 3.13

WORKDIR /workspace
ENTRYPOINT ["sh", "-c", "uv sync --locked && exec pi \"$@\"", "--"]
